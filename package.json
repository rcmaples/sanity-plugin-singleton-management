{
  "name": "sanity-plugin-singleton-management",
  "version": "1.0.7",
  "description": "A plugin to streamline singleton management in your Sanity Studio",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "RC Maples <rc@rcmaples.io>",
  "contributors": [
    "RD Pennell <racheal@sanity.io>"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "browserslist": "extends @sanity/browserslist-config",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "npm run clean && npx @sanity/pkg-utils build --strict",
    "clean": "rimraf dist",
    "commit": "commit",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepare": "husky",
    "prepublishOnly": "run-s build",
    "watch": "pkg-utils watch --strict",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/incompatible-plugin": "^1.0.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^12.1.2",
    "@sanity/plugin-kit": "^10.0.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rimraf": "^6.1.3",
    "sanity": "^6.9.2",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "prismjs": "1.30.0",
    "tmp": "0.2.4",
    "min-document": "2.19.0",
    "minimatch": "^10.2.1",
    "serialize-javascript": "^7.0.3",
    "glob": "^10.5.0",
    "flatted": "^3.4.2",
    "js-yaml": "^3.14.2",
    "ajv": "^8.18.0",
    "lodash": "^4.18.0",
    "brace-expansion": "^5.0.9",
    "picomatch": "^4.0.4",
    "smol-toml": "^1.6.1",
    "typescript": "^6.0.3",
    "typeid-js": {
      "uuid": "^11.1.1"
    },
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.29.0"
    },
    "@sanity/pkg-utils": {
      "typescript": "^6.0.3"
    }
  },
  "peerDependencies": {
    "react": "^18 || ^19.2.1",
    "sanity": "^3 || ^4 || ^5.0.0-0 || ^6"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rcmaples/sanity-plugin-singleton-management"
  },
  "sideEffects": true,
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
